<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 录音：VAD/ASR 采集 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 云端 LLM 调用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保持唤醒：长对话时屏幕常亮，避免 TTS/录音中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ★ 前台服务：后台保活语音管线 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 麦克风前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 通知：前台服务必须 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ★ 所有文件访问权限：用于把诊断日志写到 Download（用户可见、便于排查闪退）
         Android 11+ (API 30+) 需用户在系统设置里手动授予 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ★ 接收其他 App 分享的文本/文件（填入文字模式输入框，用户可编辑后发送） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 设置页：LLM baseUrl / apiKey / model，TTS 说话人/语速等 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- 聊天记录：查看/搜索/导入导出 -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <!-- ★ 后台语音服务：开启悬浮球模式后启动，前台保活 -->
        <service
            android:name=".service.VoiceAssistantService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".media.MediaListenerService"
            android:label="Argus Media Control"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>

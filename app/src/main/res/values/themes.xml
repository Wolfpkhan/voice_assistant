<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== 浅色（日间基准） ===== -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- 文本颜色默认值 -->
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <!-- 状态栏胶囊样式（顶部状态指示） -->
    <style name="StatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- 对话气泡文本 -->
    <style name="MessageText">
        <item name="android:textSize">@dimen/msg_text_size</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- 底部圆形图标按钮 -->
    <style name="CircleIconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconTint">?android:attr/textColorPrimary</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">0dp</item>
    </style>
</resources>

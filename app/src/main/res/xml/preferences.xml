<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 云端大模型 -->
    <PreferenceCategory app:title="@string/cat_llm">
        <EditTextPreference
            app:key="@string/pref_llm_baseurl"
            app:title="@string/pref_title_baseurl"
            app:summary="@string/pref_summary_baseurl"
            app:defaultValue="@string/default_baseurl" />
        <EditTextPreference
            app:key="@string/pref_llm_apikey"
            app:title="@string/pref_title_apikey"
            app:summary="@string/pref_summary_apikey"
            android:inputType="textPassword" />
        <EditTextPreference
            app:key="@string/pref_llm_model"
            app:title="@string/pref_title_model"
            app:defaultValue="@string/default_model" />
        <EditTextPreference
            app:key="@string/pref_llm_system"
            app:title="@string/pref_title_system_voice"
            app:summary="@string/pref_summary_system_voice"
            app:defaultValue="@string/default_system" />
        <EditTextPreference
            app:key="@string/pref_llm_system_text"
            app:title="@string/pref_title_system_text"
            app:summary="@string/pref_summary_system_text"
            app:defaultValue="@string/default_system_text" />
    </PreferenceCategory>

    <!-- 界面 -->
    <PreferenceCategory app:title="@string/cat_ui">
        <!-- ★ 语言切换：AppCompatDelegate.setApplicationLocales（appcompat 1.6 兼容 API<33） -->
        <ListPreference
            app:key="@string/pref_app_language"
            app:title="@string/pref_title_language"
            app:summary="@string/pref_summary_language"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:defaultValue="system" />
        <SwitchPreferenceCompat
            app:key="@string/pref_keep_screen_on"
            app:title="@string/pref_title_keep_screen_on"
            app:summary="@string/pref_summary_keep_screen_on"
            app:defaultValue="false" />
    </PreferenceCategory>

    <!-- 语音合成 -->
    <PreferenceCategory app:title="@string/cat_tts">
        <ListPreference
            app:key="@string/pref_tts_engine"
            app:title="@string/pref_title_tts_engine"
            app:entries="@array/tts_engine_entries"
            app:entryValues="@array/tts_engine_values"
            app:defaultValue="kokoro" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_tts_speed"
            app:title="@string/pref_title_tts_speed"
            app:summary="@string/pref_summary_tts_speed"
            android:max="20"
            app:defaultValue="10" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_tts_sid"
            app:title="@string/pref_title_tts_sid"
            app:summary="@string/pref_summary_tts_sid"
            android:max="102"
            app:defaultValue="3" />
        <Preference
            app:key="@string/pref_voice_preview"
            app:title="@string/pref_title_voice_preview" />
    </PreferenceCategory>

    <!-- 高级 · 对话节奏 -->
    <PreferenceCategory app:title="@string/cat_timing">
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_cooldown_ms"
            app:title="@string/pref_title_cooldown"
            app:summary="@string/pref_summary_cooldown"
            android:max="3000"
            app:defaultValue="600" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_endpoint_silence"
            app:title="@string/pref_title_endpoint_silence"
            app:summary="@string/pref_summary_endpoint_silence"
            android:max="30"
            app:defaultValue="12" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_mic_gain"
            app:title="@string/pref_title_mic_gain"
            app:summary="@string/pref_summary_mic_gain"
            android:max="30"
            app:defaultValue="10" />
    </PreferenceCategory>

    <!-- 唤醒词模式 -->
    <PreferenceCategory app:title="@string/cat_wake">
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_wake_word_idle_sec"
            app:title="@string/pref_title_wake_idle"
            app:summary="@string/pref_summary_wake_idle"
            android:max="30"
            app:defaultValue="5" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_kws_confirm_window_sec"
            app:title="@string/pref_title_confirm_window"
            app:summary="@string/pref_summary_confirm_window"
            android:max="10"
            android:min="2"
            app:defaultValue="5" />
        <SeekBarPreference
            app:showSeekBarValue="true"
            app:key="@string/pref_wake_grace_sec"
            app:title="@string/pref_title_wake_grace"
            app:summary="@string/pref_summary_wake_grace"
            android:max="20"
            android:min="5"
            app:defaultValue="8" />
        <SwitchPreferenceCompat
            app:key="@string/pref_kws_ns"
            app:title="@string/pref_title_kws_ns"
            app:summary="@string/pref_summary_kws_ns"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="@string/pref_kws_gtcrn"
            app:title="@string/pref_title_kws_gtcrn"
            app:summary="@string/pref_summary_kws_gtcrn"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="@string/pref_kws_sco"
            app:title="@string/pref_title_kws_sco"
            app:summary="@string/pref_summary_kws_sco"
            app:defaultValue="false" />
        <EditTextPreference
            app:key="@string/pref_wake_word"
            app:title="@string/pref_title_wake_word"
            app:summary="@string/pref_summary_wake_word"
            app:defaultValue="@string/default_wake_word" />
    </PreferenceCategory>

    <!-- 全局回声消除（实验性） -->
    <PreferenceCategory app:title="@string/cat_audio">
        <SwitchPreferenceCompat
            app:key="@string/pref_global_aec"
            app:title="@string/pref_title_global_aec"
            app:summary="@string/pref_summary_global_aec"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="@string/pref_pause_music"
            app:title="@string/pref_title_pause_music"
            app:summary="@string/pref_summary_pause_music"
            app:defaultValue="false" />
    </PreferenceCategory>

    <!-- ★ 设置备份：导出/导入 SharedPreferences 为 JSON，方便换机/重装 -->
    <PreferenceCategory app:title="@string/cat_backup">
        <Preference
            app:key="settings_export"
            app:title="@string/pref_title_settings_export"
            app:summary="@string/pref_summary_settings_export" />
        <Preference
            app:key="settings_import"
            app:title="@string/pref_title_settings_import"
            app:summary="@string/pref_summary_settings_import" />
    </PreferenceCategory>

</PreferenceScreen>

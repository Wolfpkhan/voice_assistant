<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="云端大模型 (OpenAI 兼容)">
        <EditTextPreference
            android:key="@string/pref_llm_baseurl"
            android:title="Base URL"
            android:summary="OpenAI 兼容接口地址"
            android:defaultValue="@string/default_baseurl"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="@string/pref_llm_apikey"
            android:title="API Key"
            android:summary="服务端密钥（本地保存）"
            android:defaultValue="@string/default_apikey"
            android:inputType="textPassword" />

        <EditTextPreference
            android:key="@string/pref_llm_model"
            android:title="模型"
            android:summary="如 deepseek-chat / qwen-plus / gpt-4o-mini"
            android:defaultValue="@string/default_model"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="@string/pref_llm_system"
            android:title="系统提示词（语音模式）"
            android:summary="语音对话的人设与风格（口语化、短句）"
            android:defaultValue="@string/default_system"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="@string/pref_llm_system_text"
            android:title="系统提示词（文字模式）"
            android:summary="文字对话的人设与风格（可用 Markdown）"
            android:defaultValue="@string/default_system_text"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="界面">
        <SwitchPreferenceCompat
            android:key="@string/pref_keep_screen_on"
            android:title="屏幕常亮"
            android:summary="前台时保持屏幕常亮（语音对话时方便查看，耗电增加）"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="语音合成">
        <SeekBarPreference
            android:key="@string/pref_tts_speed"
            android:title="语速"
            android:summary="1.0 = 正常"
            android:defaultValue="10"
            android:min="5"
            android:max="20"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="@string/pref_tts_sid"
            android:title="说话人 ID (sid)"
            android:summary="0~2 英文、3~57 中文女声（推荐）、58~102 中文男声"
            android:defaultValue="3"
            android:min="0"
            android:max="102"
            app:showSeekBarValue="true" />

        <!-- ★ 音色预览：点一下用当前 sid 生成一段试听文本 -->
        <Preference
            android:key="@string/pref_voice_preview"
            android:title="🎵 试听当前音色"
            android:summary="点击用当前 sid 生成并播放一句示例"
            android:widgetLayout="@layout/widget_loading" />
    </PreferenceCategory>

    <PreferenceCategory android:title="高级 · 对话节奏与打断">
        <SwitchPreferenceCompat
            android:key="@string/pref_enable_barge_in"
            android:title="允许语音打断 TTS"
            android:summary="开启后 TTS 播报时可说出“停/算了”中断。App 启动会自动探测设备 AEC，如支持则默认开启。"
            android:defaultValue="false" />
        <!-- 冷却：正常播完后重新聆听的间隔，防回声。打断后会跳过此冷却。 -->
        <SeekBarPreference
            android:key="@string/pref_cooldown_ms"
            android:title="播报后冷却 (ms)"
            android:summary="正常答完后等多久重新聆听，防回声"
            android:defaultValue="600"
            android:min="0"
            android:max="2000"
            app:showSeekBarValue="true" />

        <!-- ASR 端点尾静默：说完停顿多久判定该句结束 -->
        <SeekBarPreference
            android:key="@string/pref_endpoint_silence"
            android:title="说完判定延时 (×0.1s)"
            android:summary="停顿多久判定一句话说完整。越小响应越快、越大越稳"
            android:defaultValue="12"
            android:min="5"
            android:max="30"
            app:showSeekBarValue="true" />

        <!-- 打断起播保护期：TTS 出声后多久开始检测打断 -->
        <SeekBarPreference
            android:key="@string/pref_barge_guard_ms"
            android:title="打断保护期 (ms)"
            android:summary="TTS 刚出声多久内不检测打断，防误触发"
            android:defaultValue="300"
            android:min="0"
            android:max="1000"
            app:showSeekBarValue="true" />

        <!-- 打断确认时长：连续语音多久才算真打断 -->
        <SeekBarPreference
            android:key="@string/pref_barge_confirm_ms"
            android:title="打断确认时长 (ms)"
            android:summary="连续检测到语音多久才算真打断。越大越不容易误打断"
            android:defaultValue="200"
            android:min="50"
            android:max="800"
            app:showSeekBarValue="true" />

        <!-- 打断灵敏度（阈值，×0.1）。数值越小越灵敏。 -->
        <SeekBarPreference
            android:key="@string/pref_barge_threshold"
            android:title="打断灵敏度 (×0.1，越小越灵敏)"
            android:summary="GTCRN 降噪后的 VAD 阈值。越小越容易触发打断"
            android:defaultValue="6"
            android:min="3"
            android:max="9"
            app:showSeekBarValue="true" />

        <!-- 麦克风增益（远距离收音） -->
        <SeekBarPreference
            android:key="@string/pref_mic_gain"
            android:title="麦克风增益 (×0.1)"
            android:summary="放大收音。1.0=原始，2.0~3.0适合远距离/小声说话"
            android:defaultValue="10"
            android:min="10"
            android:max="30"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<!-- 助手消息：左对齐，圆形绿头像 + 文本（无气泡） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/avatar_assistant"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ★ 思考过程（折叠/展开，默认隐藏） -->
        <TextView
            android:id="@+id/reasoningHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_reasoning_pill"
            android:text="@string/reasoning_toggle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reasoningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_reasoning_box"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <!-- ★ 工具调用区（折叠/展开，默认隐藏）—— 与 reasoning 同结构，独立区域 -->
        <TextView
            android:id="@+id/toolsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingVertical="4dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_tools_pill"
            android:text="@string/tools_toggle"
            android:textColor="@color/tools_pill_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/toolsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_tools_box"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/messageText"
            style="@style/MessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

    </LinearLayout>

</LinearLayout>
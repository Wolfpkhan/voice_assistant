<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== 顶部极简标题栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- 状态指示胶囊 -->
        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_status_pill"
            android:text="@string/state_idle" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 设置图标按钮 -->
        <!-- 新对话按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/newChatButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_new_chat"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_history"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_settings"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- ===== 实时识别提示（聆听时显示） ===== -->
    <TextView
        android:id="@+id/partialText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="你(实时)：今天天气" />

    <!-- ===== 对话列表 ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:overScrollMode="never" />

    <!-- ===== 模式切换（语音/文字 互斥） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceModeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="18dp"
            android:text="@string/btn_voice_mode"
            android:textSize="14sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/textModeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="18dp"
            android:text="@string/btn_text_mode"
            android:textSize="14sp"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- ===== 底部控制栏（语音模式） ===== -->
    <LinearLayout
        android:id="@+id/voiceBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_bar"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- ★ 悬浮球开关：开启后切后台仍保持侦听（仅语音模式） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/floatingBallButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_floating_ball"
            app:iconSize="22dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <!-- 静音播放 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/muteButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:enabled="false"
            app:icon="@drawable/ic_mute"
            app:iconSize="22dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <!-- 中断输出 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/interruptButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:enabled="false"
            app:icon="@drawable/ic_interrupt"
            app:iconSize="22dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <!-- ★ 撤销当前 STT 内容并重新聆听（仅 LISTENING 状态可用） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/undoButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:enabled="false"
            app:icon="@drawable/ic_undo"
            app:iconSize="22dp"
            app:iconTint="?android:attr/textColorSecondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 开始/停止 对话（主按钮：图标+文字） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="120dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="24dp"
            android:text="@string/btn_start"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_mic"
            app:iconSize="22dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- ===== 文字输入条（文字模式） ===== -->
    <LinearLayout
        android:id="@+id/textBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <!-- 附件按钮：打开系统文件选择器，选中路径以换行拼接填入输入框 -->
        <ImageButton
            android:id="@+id/attachButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_brand"
            android:src="@drawable/ic_attach"
            android:contentDescription="@string/action_attach" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/input_hint"
            app:boxCornerRadiusBottomEnd="22dp"
            app:boxCornerRadiusBottomStart="22dp"
            app:boxCornerRadiusTopEnd="22dp"
            app:boxCornerRadiusTopStart="22dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:imeOptions="actionSend"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 停止生成（文字模式也可用，停 LLM） -->
        <ImageButton
            android:id="@+id/stopGenButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_brand"
            android:src="@drawable/ic_stop_gen"
            android:contentDescription="@string/btn_stop"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_brand"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/action_send" />
    </LinearLayout>

</LinearLayout>
